
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>TwitchChat</AssemblyName>
    <RootNamespace>TwitchChat</RootNamespace>

    <Version>0.1.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>twitchchat.ico</ApplicationIcon>

    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ChatSession.cs;TwitchIrc.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\assets\icon.png"
                      Link="Assets\icon.png" />

    <AvaloniaResource Include="..\assets\tray-mac.png"
                      Link="Assets\tray-mac.png" />

    <AvaloniaResource Include="..\assets\tray.png"
                      Link="Assets\tray.png" />

    <Content Include="..\twitchchat.ico"
             Link="twitchchat.ico"
             Condition="Exists('..\twitchchat.ico')" />

    <Content Include="twitchchat.ico"
             Link="twitchchat.ico"
             Condition="Exists('twitchchat.ico')" />

    <Content Include="..\app.html"
             Link="app.html"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\main.js"
             Link="main.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\preload.js"
             Link="preload.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\server.js"
             Link="server.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\config.json"
             Link="config.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\package.json"
             Link="package.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\package-lock.json"
             Link="package-lock.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\settings.js"
             Link="settings.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\settings.css"
             Link="settings.css"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\assets\**\*"
             Link="assets\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />

    <Content Include="..\public\**\*"
             Link="public\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
